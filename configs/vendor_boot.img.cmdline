# configs/vendor_boot.img.cmdline
#
# REFERENCE-ONLY — this file is NOT consumed by any build script.
#
# AnyKernel3 does NOT inject a cmdline into the image: it preserves the
# cmdline of the existing boot partition on-device (the professional GKI
# patch model). The bootloader supplies androidboot.* and the ROM's
# vendor_boot.img carries the rest.
#
# The lines below document the additional args Aurora expects the ROM /
# bootloader to provide. If this file is ever wired into a pack step,
# the '#' comment lines MUST be stripped first — a kernel cmdline is a
# single space-separated string and a literal '#' would break parsing.
#
# --- Android boot essentials (usbcontroller verified from LineageOS sm8450-common) ---
console=ttyMSM0,115200n8
androidboot.hardware=qcom
androidboot.console=ttyMSM0
androidboot.memcg=1
androidboot.memfract=1
androidboot.usbcontroller=a600000.dwc3
androidboot.boot_devices=soc/1d84000.ufshc

# --- Vmalloc / IOMMU ---
vmalloc=300M
cma=320M

# --- Performance / latency ---
loop.max_loop=16
kpti=off
ssbd=force-on
bootconfig
printk.devkmsg=on
firmware_class.path=/vendor/firmware

# --- zRAM hint (runtime-driven) ---
swap_factor=100

# --- Disable kernel auditing (saves CPU) ---
audit=0

# --- Disable some verbose subsystems ---
msm_dmaheaps=1
msm_rtb.filter=0x3F
msm_watchdog_v2.enable=1
msm_watchdog_v2.pet_style=1

# --- SELinux ---
androidboot.selinux=enforcing
security=selinux

# --- Loglevel ---
loglevel=6

# --- fs_mgr / fstab flags ---
androidboot.fstab_suffix=default
androidboot.partitionbau=production

# --- DDR ---
ddr_table_enable=1
msm_ddr_ecc_allow_disabling=0

# --- IPC / SMD ---
msmdrm.enable=1
